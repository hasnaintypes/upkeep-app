# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only. Required for POST /api/projects/register (programmatic project
# registration, authenticated by a per-user API key generated at
# /dashboard/api-keys -- see src/features/api-keys/) and any other trusted
# server-side code that must bypass RLS. Never expose this to the client --
# do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. A Supabase "Secret key" (Dashboard -> Settings -> API Keys -> Secret keys) --
# distinct from SUPABASE_SERVICE_ROLE_KEY. Used to invoke deployed Edge Functions that require
# `auth: "secret"` (see supabase/functions/prober), e.g. from the "run check now" Server Action
# (src/features/projects/lib/run-check.ts) or a pg_cron trigger. Never expose this to the client.
SUPABASE_SECRET_KEY=your-secret-key
