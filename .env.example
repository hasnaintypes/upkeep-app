# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only. Required for POST /api/projects/register (programmatic project
# registration) and any other trusted server-side code that must bypass RLS.
# Never expose this to the client -- do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# POST /api/projects/register v1 stub auth (see src/app/api/projects/register/route.ts) --
# a single shared secret, not real per-user API keys. Replace once Phase 6 ships.
UPKEEP_REGISTRATION_SECRET=generate-a-long-random-value
# The Supabase auth.users.id (uuid) that programmatically registered projects are owned by.
UPKEEP_REGISTRATION_OWNER_USER_ID=your-user-uuid

# Server-only. A Supabase "Secret key" (Dashboard -> Settings -> API Keys -> Secret keys) --
# distinct from SUPABASE_SERVICE_ROLE_KEY. Used to invoke deployed Edge Functions that require
# `auth: "secret"` (see supabase/functions/prober), e.g. from a future "run check now" Server
# Action or a pg_cron trigger. Never expose this to the client.
SUPABASE_SECRET_KEY=your-secret-key
